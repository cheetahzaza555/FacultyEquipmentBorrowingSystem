<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>วิทยาลัยการคอมพิวเตอร์ | ระบบหลัก</title>

    <!-- 🔗 Bootstrap CSS (CDN Version) - เพื่อให้รันได้ทันทีโดยไม่ต้องใช้ Layout/node_modules -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        xintegrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <!-- Custom Style สำหรับตกแต่ง Hero Section และความเป็นวิทยาลัยคอมพิวเตอร์ -->
    <style>
        body {
            /* Full viewport height */
            min-height: 100vh;
            margin: 0;
            padding: 0;
        }

        .college-hero {
            min-height: 100vh;
            /* Dark, Professional Background with a subtle gradient/texture */
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
            color: #e0f7fa;
            /* Center content */
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 20px;
        }

        .main-title {
            font-size: 2.5rem;
            font-weight: 700;
            letter-spacing: 1.5px;
            margin-bottom: 0.5rem;
        }

        .sub-heading {
            font-size: 1.25rem;
            color: #bdbdbd;
            margin-bottom: 2rem;
        }

        .action-button {
            /* Large, eye-catching buttons */
            font-size: 1.1rem;
            padding: 12px 30px;
            margin: 10px;
            border-radius: 50px;
            /* Pill shape */
            transition: all 0.3s ease;
            min-width: 200px;
        }

        .btn-login {
            background-color: #00bcd4;
            /* Cyan/Teal - Technology color */
            border-color: #00bcd4;
        }

        .btn-register {
            background-color: #4caf50;
            /* Green - Action color */
            border-color: #4caf50;
        }

        .btn-login:hover,
        .btn-register:hover {
            transform: translateY(-2px);
            /* Lift effect on hover */
            box-shadow: 0 6px 10px rgba(0, 0, 0, 0.3);
        }

        /* Responsive adjustments */
        @media (max-width: 576px) {
            .main-title {
                font-size: 2rem;
            }

            .sub-heading {
                font-size: 1rem;
            }

            .action-button {
                display: block;
                width: 100%;
            }
        }
    </style>
</head>

<body>
    <div class="college-hero">
        <div class="container">

            <h1 class="main-title">
                ระบบจัดการบริการ | วิทยาลัยการคอมพิวเตอร์
            </h1>
            <p class="sub-heading">
                กรุณาเข้าสู่ระบบเพื่อใช้งานระบบบริการนักศึกษาและบุคลากร
            </p>

            <div class="mt-4">
                <!-- ปุ่มเข้าสู่ระบบ -->
                <a href="/login" class="btn btn-login text-white action-button shadow-sm">
                    เข้าสู่ระบบ (Login)
                </a>

                <!-- ปุ่มสมัครสมาชิก -->
                <a href="/register" class="btn btn-register text-white action-button shadow-sm">
                    สมัครสมาชิก (Register)
                </a>
            </div>

        </div>
    </div>

    <!-- 🔗 Bootstrap JS (CDN Version) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        xintegrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</body>

</html>

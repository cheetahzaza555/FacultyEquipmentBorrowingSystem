<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>รายการอุปกรณ์ | ระบบยืมคืน</title>
    <style>
        :root {
            --primary-color: #00bcd4;
            /* สีหลัก cyan/teal */
            --dark-bg: #1e1e2f;
            --card-bg: #27293d;
            --text-color: #f8f9fa;
            --text-muted-dark: #bdbdbd;
        }

        body {
            background-color: var(--dark-bg);
            color: var(--text-color);
        }

        .equipment-card {
            background-color: var(--card-bg);
            border-radius: 12px;
            overflow: hidden;
            transition: transform 0.2s, box-shadow 0.2s;
            border: 1px solid rgba(0, 188, 212, 0.1);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
        }

        .equipment-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 188, 212, 0.3);
        }

        .card-img-top {
            height: 200px;
            object-fit: cover;
            border-bottom: 1px solid #4c4f69;
        }

        .status-badge {
            font-size: 0.8rem;
            font-weight: 600;
        }

        .status-available {
            background-color: #4caf50;
            color: white;
        }

        .status-unavailable {
            background-color: #ff9800;
            color: white;
        }

        .status-broken {
            background-color: #f44336;
            color: white;
        }

        .text-primary {
            color: var(--primary-color) !important;
        }

        .text-muted {
            color: var(--text-muted-dark) !important;
        }

        .form-control,
        .form-select {
            background-color: #3b3e55;
            border: 1px solid #4c4f69;
            color: var(--text-color);
        }

        .form-control::placeholder {
            color: #bdbdbd;
        }

        .form-select option {
            background-color: #3b3e55;
            color: var(--text-color);
        }

        .btn-outline-primary {
            color: var(--primary-color);
            border-color: var(--primary-color);
        }

        .btn-outline-primary:hover {
            background-color: var(--primary-color);
            color: var(--dark-bg);
        }

        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            color: white;
        }

        .btn-primary:hover {
            background-color: #0097a7;
        }

        .content-container {
            padding: 40px 0;
        }
    </style>
</head>

<body>
    <div class="container content-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="text-primary fw-bold">รายการอุปกรณ์</h1>
                <p class="text-muted">เลือกอุปกรณ์ที่ต้องการยืมหรือดูรายละเอียดเพิ่มเติม</p>
            </div>
        </div>
        <!-- แถบค้นหาและกรอง -->
        <div class="row mb-4 g-2">
            <div class="col-md-5">
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="ค้นหาอุปกรณ์..." aria-label="ค้นหา">
                    <button class="btn btn-outline-primary" type="button"><i class="fas fa-search"></i></button>
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select" aria-label="ประเภทอุปกรณ์">
                    <option selected>ประเภทอุปกรณ์</option>
                    <% if (typeof categories !=='undefined' ) { %>
                        <% categories.forEach(category=> { %>
                            <option value="<%= category._id %>">
                                <%= category.name %>
                            </option>
                            <% }) %>
                                <% } %>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" aria-label="สถานะ">
                    <option selected>เลือกสถานะ</option>
                    <option value="available">พร้อมใช้งาน</option>
                    <option value="unavailable">ไม่พร้อมใช้งาน</option>
                    <option value="broken">ชำรุด</option>
                </select>
            </div>
        </div>

        <!-- รายการอุปกรณ์ -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            <% if (typeof equipments !=='undefined' && equipments.length> 0) { %>
                <% equipments.forEach(equipment=> { %>
                    <div class="col">
                        <div class="card equipment-card h-100">
                            <img src="<%= equipment.image %>" class="card-img-top" alt="<%= equipment.name %>"
                                onerror="this.onerror=null; this.src='https://placehold.co/600x400/27293d/00bcd4?text=No+Image';">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title fw-bold text-truncate me-2 text-primary">
                                        <%= equipment.name %>
                                    </h5>
                                    <span
                                        class="badge rounded-pill status-badge 
                <%= equipment.status === 'available' ? 'status-available' : equipment.status === 'unavailable' ? 'status-unavailable' : 'status-broken' %>">
                                        <%= equipment.status %>
                                    </span>
                                </div>
                                <p class="card-text text-muted mb-2">
                                    <i class="fas fa-tag me-1"></i>
                                    <%= equipment.category_id ? equipment.category_id.name : 'ไม่ระบุประเภท' %>
                                </p>
                                <p class="card-text small text-muted-dark text-truncate-3">
                                    <%= equipment.description || 'ไม่มีคำอธิบาย' %>
                                </p>
                                <div class="mt-auto">
                                    <% if (equipment.status==='available' ) { %>
                                        <a href="/users/borrow/<%= equipment._id %>" class="btn btn-primary w-100">
                                            <i class="fas fa-hand-holding"></i> ยืมอุปกรณ์
                                        </a>
                                        <% } else { %>
                                            <button class="btn btn-secondary w-100" disabled>ไม่พร้อมให้ยืม</button>
                                            <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                        <% } else { %>
                            <div class="col-12 text-center py-5">
                                <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                                <p class="lead text-muted">ยังไม่มีอุปกรณ์ในระบบ</p>
                            </div>
                            <% } %>
        </div>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- สมมติว่าตัวแปร user ถูกส่งมาจาก Server (res.render) -->
    <title>Dashboard | <%= user.username %></title>
    <!-- 🔗 Bootstrap CSS CDN - แก้ไข xintegrity เป็น integrity -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        xintegrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Font Awesome CDN สำหรับไอคอน (เช่น ไอคอนออกจากระบบ) - แก้ไข xintegrity เป็น integrity -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
        xintegrity="sha512-SnH5WK+bZxgPHs44uWIX+LLMDJc55WkYwY9yVvX6K/S7N0LdG8Z+uY5hFv5W5I5eQzQ5Q==" crossorigin="anonymous"
        referrerpolicy="no-referrer" />
    <style>
        :root {
            --primary-color: #00bcd4;
            /* สีหลัก: Cyan/Teal */
            --dark-bg: #1e1e2f;
            /* พื้นหลังเข้ม */
            --card-bg: #27293d;
            /* พื้นหลัง Card */
            --text-color: #f8f9fa;
            /* สีข้อความหลัก */
        }

        body {
            background-color: var(--dark-bg);
            color: var(--text-color);
            min-height: 100vh;
        }

        /* ❌ ลบ Style เดิมของ .navbar ออก เนื่องจากจะถูกจัดการโดย navbar.ejs ที่ถูก Include */

        .dashboard-container {
            padding-top: 50px;
        }

        .welcome-card {
            background-color: var(--card-bg);
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            max-width: 600px;
            margin: 0 auto;
            text-align: center;
        }

        .logout-btn {
            background-color: #e53935;
            /* สีแดงสำหรับปุ่มออกจากระบบ */
            border-color: #e53935;
            font-weight: bold;
            transition: background-color 0.3s;
        }

        .logout-btn:hover {
            background-color: #c62828;
            border-color: #c62828;
        }

        h1 {
            color: var(--primary-color);
            font-weight: 600;
        }

        h2 {
            margin-top: 20px;
        }
    </style>
</head>

<body>
    <!-- Main Content -->
    <div class="container dashboard-container">
        <div class="welcome-card">
            <!-- เนื้อหาหลัก -->
            <h1 class="mb-4">Dashboard หลัก</h1>

            <h2 class="mb-4">ยินดีต้อนรับ, <span style="color: var(--primary-color);"><%= user.username %></span></h2>

            <!-- แสดง Role หากมี -->
            <p class="lead mb-5 text-muted">
                คุณได้เข้าสู่ระบบในฐานะ **<%= user.role === 'admin' ? 'ผู้ดูแลระบบ' : 'ผู้ใช้งานทั่วไป' %>**
            </p>

            <div class="d-grid gap-3">
                <!-- ตัวอย่างปุ่ม/ลิงก์หลักสำหรับการใช้งาน -->
                <a href="/users/profile" class="btn btn-outline-info p-3">จัดการข้อมูลส่วนตัว</a>
                <a href="/users/services" class="btn btn-outline-light p-3">ดูรายการบริการที่ขอไป</a>
            </div>

            <hr class="my-5" style="border-top: 1px solid rgba(255, 255, 255, 0.1);">

            <!-- ปุ่มออกจากระบบใน Card (เป็นทางเลือก) -->
            <a href="/logout" class="btn logout-btn btn-lg w-100">
                <i class="fas fa-sign-out-alt"></i> ออกจากระบบ
            </a>
        </div>
    </div>

    <!-- 🔗 Bootstrap JS CDN - แก้ไข xintegrity เป็น integrity -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        xintegrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</body>

</html>

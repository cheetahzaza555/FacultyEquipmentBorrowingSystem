<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- สมมติว่าตัวแปร user ถูกส่งมาจาก Server (res.render) -->
    <title>Dashboard | <%= user.username %>
    </title>
    <!-- 🔗 Bootstrap CSS CDN - แก้ไข xintegrity เป็น integrity -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        xintegrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Font Awesome CDN สำหรับไอคอน (เช่น ไอคอนออกจากระบบ) - แก้ไข xintegrity เป็น integrity -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
        xintegrity="sha512-SnH5WK+bZxgPHs44uWIX+LLMDJc55WkYwY9yVvX6K/S7N0LdG8Z+uY5hFv5W5I5eQzQ5Q=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        :root {
            --primary-color: #00bcd4;
            /* สีหลัก: Cyan/Teal */
            --dark-bg: #1e1e2f;
            /* พื้นหลังเข้ม */
            --card-bg: #27293d;
            /* พื้นหลัง Card */
            --text-color: #f8f9fa;
            /* สีข้อความหลัก */
        }

        body {
            background-color: var(--dark-bg);
            color: var(--text-color);
            min-height: 100vh;
        }

        /* ❌ ลบ Style เดิมของ .navbar ออก เนื่องจากจะถูกจัดการโดย navbar.ejs ที่ถูก Include */

        .dashboard-container {
            padding-top: 50px;
        }

        .welcome-card {
            background-color: var(--card-bg);
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            max-width: 600px;
            margin: 0 auto;
            text-align: center;
        }

        .logout-btn {
            background-color: #dc3545;
            /* สีแดงแบบ Bootstrap danger */
            border-color: #dc3545;
            color: #fff !important;
        }

        .logout-btn:hover {
            background-color: #bb2d3b;
            border-color: #bb2d3b;
        }

        h1 {
            color: var(--primary-color);
            font-weight: 600;
        }

        h2 {
            margin-top: 20px;
        }
    </style>
</head>

<body>
    <!-- Main Content -->
    <div class="container dashboard-container">
        <div class="welcome-card">
            <!-- เนื้อหาหลัก -->
            <h1 class="mb-4">Dashboard หลัก</h1>

            <h2 class="mb-4">ยินดีต้อนรับ, <span style="color: var(--primary-color);">
                    <%= user.username %>
                </span></h2>
            <div class="row g-4 mt-5 justify-content-center">
                <!-- Pending -->
                <div class="col-md-3 col-sm-6 d-flex">
                    <div class="card text-center p-4 shadow-lg rounded-4 h-100 flex-fill"
                        style="background: linear-gradient(135deg, #facc15, #fbbf24); color: #1e1e2f;">
                        <i class="fas fa-clock fa-3x mb-3"></i>
                        <h5 class="fw-bold">รอดำเนินการ</h5>
                        <p class="display-4 fw-bold mb-0">
                            <%= pending %>
                        </p>
                    </div>
                </div>

                <!-- Approved -->
                <div class="col-md-3 col-sm-6">
                    <div class="card text-center p-4 shadow-lg rounded-4 h-100 flex-fill"
                        style="background: linear-gradient(135deg, #22c55e, #16a34a); color: #fff;">
                        <i class="fas fa-check-circle fa-3x mb-3"></i>
                        <h5 class="fw-bold">อนุมัติแล้ว</h5>
                        <p class="display-4 fw-bold mb-0">
                            <%= approved %>
                        </p>
                    </div>
                </div>

                <!-- Rejected -->
                <div class="col-md-3 col-sm-6">
                    <div class="card text-center p-4 shadow-lg rounded-4 h-100 flex-fill"
                        style="background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff;">
                        <i class="fas fa-times-circle fa-3x mb-3"></i>
                        <h5 class="fw-bold">ไม่อนุมัติ</h5>
                        <p class="display-4 fw-bold mb-0">
                            <%= rejected %>
                        </p>
                    </div>
                </div>
            </div>


            <hr class="my-5" style="border-top: 1px solid rgba(255, 255, 255, 0.1);">
        </div>
    </div>

    <!-- 🔗 Bootstrap JS CDN - แก้ไข xintegrity เป็น integrity -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        xintegrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</body>

</html>
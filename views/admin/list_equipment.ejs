<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <!-- ใช้ CDN เพื่อให้รันได้ทันที -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        :root {
            --admin-primary-color: #f7a329;
            --dark-bg: #1e1e2f;
            --card-bg: #27293d;
            --text-color: #f8f9fa;
            --text-muted-dark: #bdbdbd;
        }

        body {
            background-color: var(--dark-bg);
            color: var(--text-color);
        }

        .equipment-card {
            transition: transform 0.2s, box-shadow 0.2s;
            border-radius: 12px;
            overflow: hidden;
            background-color: var(--card-bg);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(247, 163, 41, 0.1);
        }

        .equipment-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(247, 163, 41, 0.3);
        }

        .card-img-top {
            height: 200px;
            object-fit: cover;
            border-bottom: 1px solid #4c4f69;
        }

        .status-badge {
            font-size: 0.8rem;
            font-weight: 600;
        }

        .status-available {
            background-color: #4caf50;
            color: white;
        }

        .status-unavailable {
            background-color: #ff9800;
            color: white;
        }

        .status-broken {
            background-color: #f44336;
            color: white;
        }

        .content-container {
            background-color: var(--dark-bg);
            padding: 30px;
            border-radius: 8px;
        }

        .text-primary {
            color: var(--admin-primary-color) !important;
        }

        .text-muted {
            color: var(--text-muted-dark) !important;
        }

        .btn-success {
            background-color: var(--admin-primary-color);
            border-color: var(--admin-primary-color);
            color: white !important;
            font-weight: bold;
        }

        .btn-success:hover {
            background-color: #e69123;
            border-color: #e69123;
        }

        .form-control,
        .form-select {
            background-color: #3b3e55;
            border: 1px solid #4c4f69;
            color: var(--text-color);
        }

        .form-control::placeholder {
            color: #bdbdbd;
        }

        .form-select option {
            background-color: #3b3e55;
            color: var(--text-color);
        }

        .btn-outline-secondary {
            color: var(--admin-primary-color);
            border-color: var(--admin-primary-color);
        }

        .btn-outline-secondary:hover {
            background-color: var(--admin-primary-color);
            color: var(--dark-bg);
        }

        .btn-outline-primary {
            color: var(--admin-primary-color);
            border-color: var(--admin-primary-color);
        }

        .btn-outline-primary:hover {
            background-color: var(--admin-primary-color);
            color: var(--dark-bg);
        }

        .btn-info {
            background-color: #2196f3;
            border-color: #2196f3;
            color: white;
        }
    </style>
</head>

<body>

    <div class="container content-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="text-primary fw-bold">รายการอุปกรณ์</h1>
                <p class="text-muted">จัดการอุปกรณ์ทั้งหมดในระบบ</p>
            </div>
            <a href="/admin/equipment/add" class="btn btn-success btn-lg shadow-sm">
                <i class="fas fa-plus me-2"></i> เพิ่มอุปกรณ์
            </a>
        </div>

        <% if (typeof success !=='undefined' && success) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <% } %>

                <% if (typeof error !=='undefined' && error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                    <% } %>

                        <!-- Filter and Search Bar -->
                        <div class="row mb-4 g-2">
                            <div class="col-md-5">
                                <div class="input-group">
                                    <input type="text" class="form-control" placeholder="ค้นหาอุปกรณ์..."
                                        aria-label="ค้นหา">
                                    <button class="btn btn-outline-secondary" type="button"><i
                                            class="fas fa-search"></i></button>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <select class="form-select" aria-label="ประเภทอุปกรณ์">
                                    <option value="">ประเภทอุปกรณ์</option>
                                    <% if (typeof categories !=='undefined' ) { %>
                                        <% categories.forEach(category=> { %>
                                            <option value="<%= category._id %>">
                                                <%= category.name %>
                                            </option>
                                            <% }) %>
                                                <% } %>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select class="form-select" aria-label="สถานะ">
                                    <option value="">สถานะ</option>
                                    <option value="available">พร้อมใช้งาน</option>
                                    <option value="unavailable">ไม่พร้อมใช้งาน</option>
                                    <option value="broken">ชำรุด</option>
                                </select>
                            </div>
                        </div>

                        <!-- Equipment List (Grid View) -->
                        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                            <% if (typeof equipments !=='undefined' && equipments.length> 0) { %>
                                <% equipments.forEach(equipment=> { %>
                                    <div class="col">
                                        <div class="card equipment-card h-100"
                                            data-category-id="<%= equipment.category_id ? equipment.category_id._id : '' %>">
                                            <img src="<%= equipment.image %>" class="card-img-top"
                                                alt="<%= equipment.name %>"
                                                onerror="this.onerror=null; this.src='https://placehold.co/600x400/27293d/f7a329?text=No+Image';">
                                            <div class="card-body d-flex flex-column">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <h5 class="card-title fw-bold text-truncate me-2"
                                                        style="color: var(--admin-primary-color);">
                                                        <%= equipment.name %>
                                                    </h5>
                                                    <span
                                                        class="badge rounded-pill status-badge <%= equipment.status === 'available' ? 'status-available' : equipment.status === 'unavailable' ? 'status-unavailable' : 'status-broken' %>">
                                                        <%= equipment.status %>
                                                    </span>
                                                </div>
                                                <p class="card-text text-muted mb-2">
                                                    <i class="fas fa-tag me-1"></i>
                                                    <%= equipment.category_id ? equipment.category_id.name
                                                        : 'ไม่ระบุประเภท' %>
                                                </p>
                                                <p class="card-text small text-muted-dark text-truncate-3 text-primary">
                                                    <%= equipment.description || 'ไม่มีคำอธิบาย' %>
                                                </p>
                                                <div class="mt-auto d-flex justify-content-between pt-3">
                                                    <a href="/admin/edit/<%= equipment._id %>"
                                                        class="btn btn-outline-primary btn-sm">แก้ไขอุปกรณ์</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <div class="col-12 text-center py-5">
                                                <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                                                <p class="lead text-muted">ยังไม่มีอุปกรณ์ในระบบ</p>
                                                <p class="text-muted">คลิกปุ่ม 'เพิ่มอุปกรณ์' เพื่อเริ่มต้น</p>
                                            </div>
                                            <% } %>
                        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.querySelector('input[placeholder="ค้นหาอุปกรณ์..."]');
            const categorySelect = document.querySelector('select[aria-label="ประเภทอุปกรณ์"]');
            const statusSelect = document.querySelector('select[aria-label="สถานะ"]');
            const equipmentCards = document.querySelectorAll('.equipment-card');

            function filterEquipments() {
                const searchText = searchInput.value.toLowerCase();
                const selectedCategory = categorySelect.value;
                const selectedStatus = statusSelect.value;

                equipmentCards.forEach(card => {
                    const name = card.querySelector('.card-title').textContent.toLowerCase();
                    const categoryId = card.getAttribute('data-category-id');
                    const status = card.querySelector('.status-badge').textContent.trim().toLowerCase();

                    const matchesSearch = name.includes(searchText);
                    const matchesCategory = selectedCategory === "" || categoryId === selectedCategory;
                    const matchesStatus = selectedStatus === "" || status === selectedStatus.toLowerCase();

                    if (matchesSearch && matchesCategory && matchesStatus) {
                        card.parentElement.style.display = "";
                    } else {
                        card.parentElement.style.display = "none";
                    }
                });
            }

            searchInput.addEventListener('input', filterEquipments);
            categorySelect.addEventListener('change', filterEquipments);
            statusSelect.addEventListener('change', filterEquipments);
        });
    </script>

</body>

</html>
<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- สมมติว่าตัวแปร user ถูกส่งมาจาก Server (res.render) -->
    <title>Admin Dashboard | <%= typeof user !=='undefined' ? user.username : 'Admin' %>
    </title>

    <!-- 🔗 Bootstrap CSS CDN - แก้ไข 'xintegrity' เป็น 'integrity' -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        xintegrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Font Awesome CDN สำหรับไอคอน (เช่น ไอคอนออกจากระบบ) - แก้ไข 'xintegrity' เป็น 'integrity' -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
        xintegrity="sha512-SnH5WK+bZxgPHs44uWIX+LLMDJc55WkYwY9yVvX6K/S7N0LdG8Z+uY5hFv5W5I5eQzQ5Q=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />

    <style>
        :root {
            --primary-color: #f7a329;
            /* สีหลัก: Amber/Orange สำหรับ Admin */
            --dark-bg: #1e1e2f;
            /* พื้นหลังเข้ม */
            --card-bg: #27293d;
            /* พื้นหลัง Card */
            --text-color: #f8f9fa;
            /* สีข้อความหลัก */
            --secondary-bg: #13131f;
            /* สีพื้นหลังเข้มกว่าสำหรับ Footer/Navbar */
        }

        body {
            background-color: var(--dark-bg);
            color: var(--text-color);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Main Content */
        .dashboard-container {
            flex-grow: 1;
            /* ทำให้เนื้อหาหลักกินพื้นที่ที่เหลือ */
            padding-top: 30px;
            padding-bottom: 50px;
        }

        .welcome-card {
            background-color: var(--card-bg);
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 6px 30px rgba(0, 0, 0, 0.7);
            /* เงาเข้มขึ้น */
            max-width: 800px;
            /* เพิ่มความกว้าง */
            margin: 0 auto;
            text-align: center;
        }

        h1 {
            color: var(--primary-color);
            font-weight: 700;
            text-shadow: 0 0 5px rgba(247, 163, 41, 0.4);
            /* เพิ่มเงาให้ตัวหนังสือ */
        }

        .admin-link {
            transition: transform 0.3s, box-shadow 0.3s;
            background-color: #3b3e55;
            border: 1px solid var(--primary-color);
            font-size: 1.1rem;
            font-weight: 600;
        }

        .admin-link:hover {
            transform: translateY(-5px);
            /* ยกขึ้นมากกว่าเดิม */
            box-shadow: 0 10px 20px rgba(247, 163, 41, 0.5);
            /* เงาสีส้มชัดเจนขึ้น */
            background-color: #4c4f69;
            color: var(--text-color);
        }

        /* Footer */
        .footer {
            background-color: var(--secondary-bg);
            color: rgba(255, 255, 255, 0.5);
            padding: 15px 0;
            border-top: 1px solid rgba(247, 163, 41, 0.2);
            text-align: center;
            font-size: 0.85rem;
        }
    </style>
</head>

<body>

    <!-- Main Content -->
    <div class="container dashboard-container">
        <div class="welcome-card">
            <h1 class="mb-4"><i class="fas fa-crown me-2"></i> แผงควบคุมผู้ดูแลระบบ</h1>
            <h2 class="mb-4 text-white">
                ยินดีต้อนรับ,
                <span style="color: var(--primary-color);">
                    <%= typeof user !=='undefined' ? user.username : 'Username' %>
                </span>
            </h2>

            <hr class="my-5" style="border-top: 1px solid rgba(255, 255, 255, 0.1);">

            <!-- Dashboard Stats -->
            <div class="row g-4 mt-4">
                <!-- อุปกรณ์ทั้งหมด -->
                <div class="col-md-6">
                    <div class="card p-4 shadow-lg rounded-4"
                        style="background: linear-gradient(135deg, #f7a329, #fbbf24); color: #1e1e2f;">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-boxes fa-3x me-3"></i>
                            <div>
                                <h4 class="mb-2 fw-bold">อุปกรณ์ทั้งหมด</h4>
                                <p class="display-4 fw-bold mb-0">
                                    <%= totalEquipments %>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- คำขอยืมที่รอดำเนินการ -->
                <div class="col-md-6">
                    <div class="card p-4 shadow-lg rounded-4"
                        style="background: linear-gradient(135deg, #22c55e, #16a34a); color: #fff;">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-hand-holding fa-3x me-3"></i>
                            <div>
                                <h4 class="mb-2 fw-bold">คำขอยืมที่รอดำเนินการ</h4>
                                <p class="display-4 fw-bold mb-0">
                                    <%= pendingRequests %>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 🔗 Bootstrap JS CDN (แก้ไข xintegrity เป็น integrity) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        xintegrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</body>

</html>
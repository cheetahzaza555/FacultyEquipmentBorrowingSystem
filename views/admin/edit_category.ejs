<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>แก้ไขหมวดหมู่อุปกรณ์</title>

    <!-- Bootstrap + FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet"
        crossorigin="anonymous">

    <style>
        :root {
            --primary-color: #f7a329;
            --dark-bg: #1e1e2f;
            --card-bg: #27293d;
            --text-color: #f8f9fa;
            --secondary-bg: #13131f;
        }

        body {
            background-color: var(--dark-bg);
            color: var(--text-color);
            min-height: 100vh;
        }

        .page-header {
            background-color: var(--card-bg);
            border-radius: 12px;
            padding: 20px 25px;
            box-shadow: 0 6px 25px rgba(0, 0, 0, 0.6);
            margin-bottom: 25px;
        }

        h2 {
            color: var(--primary-color);
            font-weight: 600;
        }

        .btn-primary {
            background-color: var(--primary-color);
            border: none;
            font-weight: 600;
        }

        .btn-primary:hover {
            background-color: #e09322;
        }

        .btn-secondary {
            background-color: #3b3e55;
            border: none;
            color: var(--text-color);
        }

        .btn-secondary:hover {
            background-color: #4c4f69;
            color: var(--text-color);
        }

        .alert {
            border-radius: 8px;
        }
    </style>
</head>

<body>
    <div class="container mt-5">
        <!-- ส่วนหัว -->
        <div class="page-header d-flex justify-content-between align-items-center">
            <h2><i class="fas fa-tags me-2"></i> แก้ไขหมวดหมู่อุปกรณ์</h2>
            <a href="/admin/categories" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i> กลับไปหน้าหมวดหมู่
            </a>
        </div>

        <!-- แสดงข้อความ error / success -->
        <% if (typeof error !=='undefined' ) { %>
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle me-1"></i>
                <%= error %>
            </div>
            <% } %>
                <% if (typeof success !=='undefined' ) { %>
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle me-1"></i>
                        <%= success %>
                    </div>
                    <% } %>

                        <!-- ฟอร์มแก้ไขหมวดหมู่ -->
                        <div class="card"
                            style="background-color: var(--card-bg); border: none; box-shadow: 0 6px 25px rgba(0,0,0,0.6); border-radius: 12px;">
                            <div class="card-body p-4 p-md-5">
                                <form action="/admin/categories/edit/<%= category._id %>" method="POST">
                                    <div class="mb-3">
                                        <label for="name" class="form-label" style="color: white;">ชื่อหมวดหมู่</label>
                                        <input type="text" class="form-control" id="name" name="name"
                                            value="<%= category.name %>" placeholder="กรอกชื่อหมวดหมู่" required>
                                    </div>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save me-1"></i> บันทึกการเปลี่ยนแปลง
                                    </button>
                                    <a href="/admin/categories" class="btn btn-secondary ms-2">
                                        ยกเลิก
                                    </a>
                                </form>
                            </div>
                        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        crossorigin="anonymous"></script>
</body>

</html>
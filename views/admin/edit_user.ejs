<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>แก้ไขผู้ใช้งาน: <%= userToEdit.firstName %>
            <%= userToEdit.lastName %>
    </title>

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        crossorigin="anonymous">

    <!-- ===== Custom Admin Orange Dark Theme ===== -->
    <style>
        :root {
            --primary-color: #f7a329;
            /* ส้มหลัก (Admin Orange) */
            --dark-bg: #1e1e2f;
            --card-bg: #27293d;
            --text-color: #f8f9fa;
            --input-bg: #3b3e55;
            --input-border: #5d6185;
            --error-bg: #4f2c2c;
            --error-text: #ffb3b3;
        }

        /* พื้นหลังและตัวอักษร */
        body {
            background-color: var(--dark-bg);
            color: var(--text-color);
            font-family: 'Inter', sans-serif;
        }

        .center-container {
            display: flex;
            justify-content: center;
            align-items: flex-start;
            /* ขยับจากกึ่งกลางขึ้นบน */
            min-height: 100vh;
            padding-top: 10vh;
            /* ระยะจากด้านบน (10% ของความสูงหน้าจอ) */
            padding-left: 20px;
            padding-right: 20px;
        }

        /* Card หลัก */
        .user-card {
            width: 100%;
            max-width: 500px;
            background-color: var(--card-bg);
            border: 1px solid var(--primary-color);
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.7);
            overflow: hidden;
        }

        .card-header {
            background-color: var(--card-bg);
            color: var(--primary-color);
            border-bottom: 2px solid var(--primary-color);
            text-align: center;
            padding: 1.25rem;
        }

        .card-header h1 {
            font-size: 1.4rem;
            margin: 0;
            font-weight: 600;
        }

        /* ปรับแต่งฟอร์ม */
        .form-label {
            color: var(--text-color);
            font-weight: 500;
        }

        .form-control,
        .form-select {
            background-color: var(--input-bg);
            color: var(--text-color);
            border: 1px solid var(--input-border);
            border-radius: 8px;
            transition: border-color 0.25s, box-shadow 0.25s;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.25rem rgba(247, 163, 41, 0.25);
        }

        /* Readonly Field */
        .form-control[readonly] {
            background-color: #2f3043;
            border-color: #444663;
            opacity: 0.9;
            cursor: not-allowed;
        }

        /* ปุ่มบันทึก */
        .btn-success {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            color: #1e1e2f;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.2s ease-in-out;
            box-shadow: 0 4px 10px rgba(247, 163, 41, 0.3);
        }

        .btn-success:hover {
            background-color: #e09322;
            border-color: #e09322;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(247, 163, 41, 0.5);
        }

        /* ปรับ alert สีแดง */
        .alert-danger {
            background-color: var(--error-bg);
            color: var(--error-text);
            border-color: #6a3434;
            border-radius: 8px;
        }

        /* ลิงก์ย้อนกลับ */
        .back-link {
            display: block;
            text-align: center;
            margin-top: 1rem;
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s;
        }

        .back-link:hover {
            color: #ffcc80;
        }
    </style>
</head>

<body>
    <div class="center-container">
        <div class="card user-card">
            <div class="card-header">
                <h1>แก้ไขผู้ใช้งาน: <%= userToEdit.firstName %>
                        <%= userToEdit.lastName %>
                </h1>
            </div>

            <div class="card-body p-4">
                <!-- แสดง Error ถ้ามี -->
                <% if (typeof error !=='undefined' && error) { %>
                    <div class="alert alert-danger mb-4" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <%= error %>
                    </div>
                    <% } %>

                        <!-- ฟอร์มแก้ไข -->
                        <form action="/admin/users/edit/<%= userToEdit._id %>" method="POST">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="firstName" class="form-label">ชื่อ:</label>
                                    <input type="text" id="firstName" name="firstName" class="form-control"
                                        value="<%= userToEdit.firstName %>" readonly>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="lastName" class="form-label">นามสกุล:</label>
                                    <input type="text" id="lastName" name="lastName" class="form-control"
                                        value="<%= userToEdit.lastName %>" readonly>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="email" class="form-label">อีเมล:</label>
                                <input type="email" id="email" name="email" class="form-control"
                                    value="<%= userToEdit.email %>" readonly>
                            </div>

                            <div class="mb-3">
                                <label for="role" class="form-label">บทบาท (สิทธิ์):</label>
                                <select id="role" name="role" class="form-select" required>
                                    <% roles.forEach(roleOption=> { %>
                                        <option value="<%= roleOption %>" <%=userToEdit.role===roleOption ? 'selected'
                                            : '' %>>
                                            <%= roleOption.charAt(0).toUpperCase() + roleOption.slice(1) %>
                                        </option>
                                        <% }); %>
                                </select>
                            </div>

                            <div class="mb-4">
                                <label for="major" class="form-label">สาขา/คณะ:</label>
                                <select id="major" name="major" class="form-select">
                                    <option value="">-- ไม่ระบุสาขา --</option>
                                    <% majors.forEach(major=> {
                                        let isMajorSelected = userToEdit.major && userToEdit.major._id &&
                                        userToEdit.major._id.toString() === major._id.toString();
                                        %>
                                        <option value="<%= major._id %>" <%=isMajorSelected ? 'selected' : '' %>>
                                            <%= major.majorName %>
                                        </option>
                                        <% }); %>
                                </select>
                            </div>

                            <button type="submit" class="btn btn-success btn-lg w-100">
                                <i class="fas fa-save me-2"></i> บันทึกการแก้ไข
                            </button>
                        </form>

                        <a href="/admin/users" class="back-link mt-3">
                            <i class="fas fa-arrow-left me-1"></i> กลับไปหน้าจัดการผู้ใช้งาน
                        </a>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        crossorigin="anonymous"></script>
    <!-- Font Awesome -->
    <script src="https://kit.fontawesome.com/a2e0e6d66d.js" crossorigin="anonymous"></script>
</body>

</html>
<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>แก้ไขอุปกรณ์: <%= equipment.name %>
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        crossorigin="anonymous">

    <style>
        :root {
            --primary-color: #f7a329;
            --dark-bg: #1e1e2f;
            --card-bg: #27293d;
            --text-color: #f8f9fa;
            --input-bg: #3b3e55;
            --input-border: #5d6185;
            --error-bg: #4f2c2c;
            --error-text: #ffb3b3;
        }

        body {
            background-color: var(--dark-bg);
            color: var(--text-color);
            font-family: 'Inter', sans-serif;
        }

        .center-container {
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
            padding-top: 8vh;
            padding-left: 20px;
            padding-right: 20px;
        }

        .equipment-card {
            width: 100%;
            max-width: 550px;
            background-color: var(--card-bg);
            border: 1px solid var(--primary-color);
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.7);
        }

        .card-header {
            background-color: var(--card-bg);
            color: var(--primary-color);
            border-bottom: 2px solid var(--primary-color);
            text-align: center;
            padding: 1.25rem;
        }

        .card-header h1 {
            font-size: 1.4rem;
            margin: 0;
            font-weight: 600;
        }

        .form-label {
            color: var(--text-color);
            font-weight: 500;
        }

        .form-control,
        .form-select {
            background-color: var(--input-bg);
            color: var(--text-color);
            border: 1px solid var(--input-border);
            border-radius: 8px;
            transition: border-color 0.25s, box-shadow 0.25s;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.25rem rgba(247, 163, 41, 0.25);
        }

        .btn-success {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            color: #1e1e2f;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.2s ease-in-out;
            box-shadow: 0 4px 10px rgba(247, 163, 41, 0.3);
        }

        .btn-success:hover {
            background-color: #e09322;
            border-color: #e09322;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(247, 163, 41, 0.5);
        }

        .alert-danger {
            background-color: var(--error-bg);
            color: var(--error-text);
            border-color: #6a3434;
            border-radius: 8px;
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 1rem;
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s;
        }

        .back-link:hover {
            color: #ffcc80;
        }

        .image-preview {
            width: 100%;
            max-height: 200px;
            object-fit: contain;
            margin-bottom: 1rem;
            border-radius: 10px;
            border: 1px solid var(--input-border);
        }
    </style>
</head>

<body>
    <div class="center-container">
        <div class="card equipment-card">
            <div class="card-header">
                <h1>แก้ไขอุปกรณ์: <%= equipment.name %>
                </h1>
            </div>

            <div class="card-body p-4">
                <% if (typeof error !=='undefined' && error) { %>
                    <div class="alert alert-danger mb-4" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <%= error %>
                    </div>
                    <% } %>

                        <form action="/admin/edit/<%= equipment._id %>" method="POST"
                            enctype="multipart/form-data">
                            <!-- ชื่ออุปกรณ์ -->
                            <div class="mb-3">
                                <label for="name" class="form-label">ชื่ออุปกรณ์:</label>
                                <input type="text" id="name" name="name" class="form-control" required
                                    value="<%= equipment.name %>">
                            </div>

                            <!-- หมวดหมู่ -->
                            <div class="mb-3">
                                <label for="category_id" class="form-label">หมวดหมู่:</label>
                                <select id="category_id" name="category_id" class="form-select" required>
                                    <% categories.forEach(cat=> { %>
                                        <option value="<%= cat._id %>" <%=equipment.category_id &&
                                            equipment.category_id.toString()===cat._id.toString() ? 'selected' : '' %>>
                                            <%= cat.name %>
                                        </option>
                                        <% }) %>
                                </select>
                            </div>

                            <!-- คำอธิบาย -->
                            <div class="mb-3">
                                <label for="description" class="form-label">คำอธิบาย:</label>
                                <textarea id="description" name="description" class="form-control" rows="3"
                                    placeholder="รายละเอียดเพิ่มเติม เช่น อุปกรณ์ใช้ในห้อง 301 หรือ สายชำรุดบางส่วน"><%= equipment.description %></textarea>
                            </div>

                            <!-- สถานะ -->
                            <div class="mb-3">
                                <label for="status" class="form-label">สถานะ:</label>
                                <select id="status" name="status" class="form-select" required>
                                    <option value="available" <%=equipment.status==='available' ? 'selected' : '' %>
                                        >พร้อมใช้งาน</option>
                                    <option value="unavailable" <%=equipment.status==='unavailable' ? 'selected' : '' %>
                                        >ไม่พร้อมใช้งาน</option>
                                    <option value="broken" <%=equipment.status==='broken' ? 'selected' : '' %>>ชำรุด
                                    </option>
                                </select>
                            </div>

                            <!-- รูปภาพ -->
                            <div class="mb-4">
                                <label for="image" class="form-label">รูปภาพอุปกรณ์:</label>
                                <img src="<%= equipment.image %>" alt="Preview" class="image-preview">
                                <input type="file" id="image" name="image" class="form-control">
                                <small class="text-secondary">หากไม่อัปโหลดใหม่ จะใช้รูปเดิม</small>
                            </div>

                            <!-- ปุ่มบันทึก -->
                            <button type="submit" class="btn btn-success btn-lg w-100">
                                <i class="fas fa-save me-2"></i> บันทึกการแก้ไข
                            </button>
                        </form>

                        <a href="/admin/equipment" class="back-link mt-3">
                            <i class="fas fa-arrow-left me-1"></i> กลับไปหน้าจัดการอุปกรณ์
                        </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        crossorigin="anonymous"></script>
    <script src="https://kit.fontawesome.com/a2e0e6d66d.js" crossorigin="anonymous"></script>
</body>

</html>
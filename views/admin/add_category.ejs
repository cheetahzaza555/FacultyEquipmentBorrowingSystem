<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>เพิ่มหมวดหมู่อุปกรณ์</title>

    <!-- Bootstrap + FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" crossorigin="anonymous">

    <style>
        :root {
            --primary-color: #f7a329;
            --dark-bg: #1e1e2f;
            --card-bg: #27293d;
            --text-color: #f8f9fa;
        }

        body {
            background-color: var(--dark-bg);
            color: var(--text-color);
            min-height: 100vh;
        }

        .card-form {
            background-color: var(--card-bg);
            border: 1px solid var(--primary-color);
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.3);
        }

        h1 {
            color: var(--primary-color);
        }

        .btn-primary {
            background-color: var(--primary-color);
            border: none;
            font-weight: 600;
        }

        .btn-primary:hover {
            background-color: #e09322;
        }

        .btn-secondary {
            font-weight: 600;
        }

        .form-control {
            background-color: #3b3e55;
            border: 1px solid #4c4f69;
            color: var(--text-color);
        }

        .form-control::placeholder {
            color: #bdbdbd;
        }

        .alert {
            border-radius: 8px;
        }
    </style>
</head>

<body>
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1><i class="fas fa-tags me-2"></i> เพิ่มหมวดหมู่อุปกรณ์</h1>
            <a href="/admin/categories" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i> กลับไปหน้าหมวดหมู่
            </a>
        </div>

        <!-- Card Form -->
        <div class="card card-form mx-auto" style="max-width: 600px;">

            <!-- แสดง Error / Success -->
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle me-1"></i> <%= error %>
                </div>
            <% } %>
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success">
                    <i class="fas fa-check-circle me-1"></i> <%= success %>
                </div>
            <% } %>

            <form action="/admin/categories/add" method="POST">
                <div class="mb-3">
                    <label for="categoryName" class="form-label" style="color: white;">ชื่อหมวดหมู่</label>
                    <input type="text" class="form-control" id="categoryName" name="name" placeholder="กรอกชื่อหมวดหมู่" required maxlength="100">
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <a href="/admin/categories" class="btn btn-secondary me-2">ยกเลิก</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> บันทึก</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>

</html>

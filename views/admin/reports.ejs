<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <title>รายงานการยืมอุปกรณ์ | ระบบแอดมิน</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root {
            --primary-color: #f7a329;
            /* สีหลักส้มทอง */
            --dark-bg: #1e1e2f;
            --card-bg: #27293d;
            --text-color: #f8f9fa;
        }

        /* Background & Text */
        body {
            background-color: var(--dark-bg);
            color: var(--text-color);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Card */
        .report-card {
            background-color: var(--card-bg);
            border: 1px solid var(--primary-color);
            border-radius: 12px;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.3);
        }

        /* Table */
        .table-dark {
            --bs-table-bg: #3b3e55;
            --bs-table-striped-bg: #4c4f69;
            --bs-table-hover-bg: #5d6185;
            --bs-table-border-color: #5d6185;
            color: var(--text-color);
        }

        /* Header Title */
        h1,
        h2 {
            color: var(--primary-color);
        }

        /* Buttons */
        .btn-approve {
            background-color: #4CAF50;
            border: none;
            color: #fff;
            font-weight: 600;
            transition: all 0.2s ease-in-out;
            box-shadow: 0 4px 10px rgba(76, 175, 80, 0.3);
        }

        .btn-approve:hover {
            background-color: #45a049;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(76, 175, 80, 0.5);
        }

        .btn-reject {
            background-color: #f44336;
            border: none;
            color: #fff;
            font-weight: 600;
            transition: all 0.2s ease-in-out;
            box-shadow: 0 4px 10px rgba(244, 67, 54, 0.3);
        }

        .btn-reject:hover {
            background-color: #e53935;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(244, 67, 54, 0.5);
        }

        /* Badges */
        .badge {
            font-size: 0.85em;
            border-radius: 0.4rem;
            padding: 0.4em 0.6em;
        }

        .badge-waiting {
            background-color: #ffc107;
            color: #1e1e2f;
        }

        .badge-borrowed {
            background-color: #00bcd4;
        }

        .badge-returned {
            background-color: #4caf50;
        }

        .badge-rejected {
            background-color: #f44336;
        }

        .badge-late {
            background-color: #9c27b0;
        }

        /* Muted text */
        .text-muted,
        .text-white-muted {
            color: rgba(255, 255, 255, 0.5) !important;
        }
    </style>

</head>

<body>
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0"> <i class="fas fa-chart-bar me-2"></i> รายงานการยืมอุปกรณ์ทั้งหมด </h1>
        </div>
        <div class="card shadow-lg rounded-4 report-card p-4 p-md-5">
            <% if (borrows && borrows.length> 0) { %>
                <div class="table-responsive">
                    <table class="table table-dark table-striped table-hover rounded-3 overflow-hidden text-center">
                        <thead>
                            <tr>
                                <th>ลำดับ</th>
                                <th>ชื่อผู้ยืม</th>
                                <th>รหัสนักศึกษา</th>
                                <th>ชื่ออุปกรณ์</th>
                                <th>วันที่ยืม</th>
                                <th>กำหนดคืน</th>
                                <th>สถานะ</th>
                                <th>จัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% borrows.forEach((b, i)=> { %>
                                <tr>
                                    <td>
                                        <%= i + 1 %>
                                    </td>
                                    <td>
                                        <%= b.user_id ? b.user_id.firstName : '-' %>
                                            <%= b.user_id ? b.user_id.lastName : '-' %>
                                    </td>
                                    <td>
                                        <%= b.user_id ? b.user_id.userId : '-' %>
                                    </td>
                                    <td>
                                        <%= b.equipment_id ? b.equipment_id.name : '-' %>
                                    </td>
                                    <td>
                                        <%= new Date(b.created_at).toLocaleDateString('th-TH') %>
                                    </td>
                                    <td>
                                        <%= new Date(b.return_date).toLocaleDateString('th-TH') %>
                                    </td>
                                    <td>
                                        <% if (b.status==='waitingForApproval' ) { %>
                                            <span class="badge badge-waiting">รออนุมัติ</span>
                                            <% } else if (b.status==='borrowed' ) { %>
                                                <span class="badge badge-borrowed">กำลังยืม</span>
                                                <% } else if (b.status==='returned' ) { %>
                                                    <span class="badge badge-returned">คืนแล้ว</span>
                                                    <% } else if (b.status==='rejected' ) { %>
                                                        <span class="badge badge-rejected">ถูกปฏิเสธ</span>
                                                        <% } else if (b.status==='late' ) { %>
                                                            <span class="badge badge-late">เกินกำหนด</span>
                                                            <% } %>
                                    </td>
                                    <td>
                                        <% if (b.status==='waitingForApproval' ) { %>
                                            <button type="button" class="btn btn-sm btn-approve me-1"
                                                onclick="confirmAction('<%= b._id %>', 'approve')">
                                                <i class="fas fa-check"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-reject"
                                                onclick="confirmAction('<%= b._id %>', 'reject')">
                                                <i class="fas fa-times"></i>
                                            </button>
                                            <% } else { %>
                                                <span class="text-white-muted">-</span>
                                                <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                    <div class="alert alert-warning text-center" role="alert">
                        <i class="fas fa-info-circle me-1"></i> ไม่พบข้อมูลการยืมในระบบ
                    </div>
                    <% } %>
        </div>
    </div>

    <script>
        function confirmAction(id, action) {
            const actionText = action === 'approve' ? 'อนุมัติ' : 'ปฏิเสธ';
            const icon = action === 'approve' ? 'success' : 'error';
            const formAction = `/admin/reports/update/${id}`;

            Swal.fire({
                title: `ยืนยันการ${actionText}?`,
                text: "การดำเนินการนี้ไม่สามารถย้อนกลับได้",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f7a329',
                cancelButtonColor: '#6c757d',
                confirmButtonText: `ยืนยันการ${actionText}`,
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    // ส่งข้อมูลไปยัง backend
                    fetch(formAction, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `action=${action}`
                    }).then(() => {
                        Swal.fire({
                            icon: icon,
                            title: `${actionText}สำเร็จ!`,
                            showConfirmButton: false,
                            timer: 1200
                        });
                        setTimeout(() => location.reload(), 1300);
                    });
                }
            });
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
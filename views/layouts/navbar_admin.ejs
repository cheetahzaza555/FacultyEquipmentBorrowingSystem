<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof title !=='undefined' ? title : 'Admin Panel' %>
    </title>

    <!-- 🔗 Bootstrap CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- 🔗 Font Awesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
        :root {
            --primary-color: #f7a329;
            /* สีหลัก: Amber/Orange สำหรับ Admin */
            --dark-bg: #1e1e2f;
            --card-bg: #27293d;
            --text-color: #f8f9fa;
        }

        body {
            background-color: var(--dark-bg);
            color: var(--text-color);
            min-height: 100vh;
        }

        .navbar {
            background-color: var(--card-bg);
            border-bottom: 3px solid var(--primary-color);
        }

        .navbar-nav .nav-link {
            color: var(--text-color);
            border-radius: 6px;
            /* เพิ่ม padding-bottom เพื่อรองรับ border-bottom ใน active state */
            padding: 8px 15px;
            transition: all 0.2s;
        }

        /* Highlight active link with requested bottom border style */
        .navbar-nav .nav-link.active {
            font-weight: 700;
            color: var(--primary-color) !important;
            /* ใช้สีหลักให้โดดเด่น */
            border-bottom: 3px solid var(--primary-color);
            padding-bottom: 5px;
            /* เพื่อให้ข้อความไม่ติดขอบล่างเกินไป */
            background-color: transparent !important;
            /* ล้างพื้นหลังเดิม */
        }

        /* Hover behavior - ใช้สีโปร่งใสเล็กน้อย */
        .navbar-nav .nav-link:hover {
            background-color: rgba(247, 163, 41, 0.1);
            /* สีหลักแบบโปร่งใส */
            color: white;
            font-weight: 600;
        }

        .logout-btn {
            background-color: #dc3545;
            /* สีแดงแบบ Bootstrap danger */
            border-color: #dc3545;
            color: #fff !important;
        }

        .logout-btn:hover {
            background-color: #bb2d3b;
            border-color: #bb2d3b;
        }

        .content-wrapper {
            padding-top: 20px;
        }
    </style>
</head>

<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
        <div class="container-fluid container">
            <a class="navbar-brand fw-bold text-uppercase" style="color: var(--primary-color);" href="/admin/dashboard">
                <i class="fas fa-tools me-2"></i> ADMIN PANEL
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminMenu"
                aria-controls="adminMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="adminMenu">
                <!-- Admin Menu Links -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <!-- 1. แผงควบคุม (Dashboard) -->
                    <li class="nav-item">
                        <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>"
                            href="/admin/dashboard">
                            <i class="fas fa-tachometer-alt me-1"></i> หน้าหลัก
                        </a>
                    </li>

                    <!-- 2. ผู้ใช้งาน (Users) -->
                    <li class="nav-item">
                        <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'users' ? 'active' : '' %>"
                            href="/admin/users">
                            <i class="fas fa-user-friends me-1"></i> ผู้ใช้งาน
                        </a>
                    </li>

                    <!-- 3. อุปกรณ์ (Equipment) - แก้ไขและเพิ่มลิงก์ให้ตรงกับ Route ใหม่ -->
                    <li class="nav-item">
                        <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'equipment_list' || activePage === 'add_equipment' ? 'active' : '' %>"
                            href="/admin/equipment">
                            <i class="fas fa-boxes me-1"></i> อุปกรณ์
                        </a>
                    </li>

                    <!-- 4. รายงาน (Reports) -->
                    <li class="nav-item">
                        <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'reports' ? 'active' : '' %>"
                            href="/admin/reports">
                            <i class="fas fa-chart-bar me-1"></i> รายงาน
                        </a>
                    </li>
                </ul>

                <!-- User Info and Logout -->
                <span class="navbar-text me-3 d-none d-lg-block" style="color: var(--text-color);">
                    <i class="fas fa-user-shield me-1"></i> Admin: <%= typeof user !=='undefined' ? user.username
                        : 'Username' %>
                </span>
                <!-- 💡 แก้ไข: ลบ btn-sm ออกเพื่อให้ใช้ขนาดตาม Custom CSS -->
                <a href="/logout" class="btn logout-btn text-white btn-danger">
                    <i class="fas fa-sign-out-alt me-1"></i> ออกจากระบบ
                </a>

            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <div class="container content-wrapper">
        <%- body %>
    </div>

    <!-- 🔗 Bootstrap JS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>